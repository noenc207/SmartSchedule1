# ==============================================================================
# SmartSchedule — Production Nginx SSL Configuration Template
# Instructions:
# 1. Replace 'YOUR_DOMAIN_HERE' with your real domain (e.g. schedule.yourdomain.com).
# 2. Update certificate paths to your Let's Encrypt / Certbot paths.
# 3. If running inside Docker Compose, upstream is 'http://backend:8080'.
#    If running directly on VPS host, upstream is 'http://127.0.0.1:8080'.
# ==============================================================================

# Rate limiting zones (protects against brute-force and DDoS)
limit_req_zone $binary_remote_addr zone=prod_auth_limit:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=prod_api_limit:10m rate=150r/m;

# HTTP (Port 80) -> Automatic Redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN_HERE;

    # Let's Encrypt ACME Challenge location
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS (Port 443)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN_HERE;

    # Root directory for static SPA build files
    root /var/www/smartschedule/dist;
    index index.html;

    # SSL Certificates (Let's Encrypt standard paths)
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN_HERE/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN_HERE/privkey.pem;

    # Modern TLS Security Parameters
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # HSTS (Strict-Transport-Security)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Standard Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;

    # Auth endpoints: Strict Rate Limiting & Anti-Spoofing Headers
    location /api/v1/auth/ {
        limit_req zone=prod_auth_limit burst=10 nodelay;
        limit_req_status 429;

        # Replace upstream with backend:8080 for Docker, or 127.0.0.1:8080 for host native
        proxy_pass http://127.0.0.1:8080/api/v1/auth/;
        proxy_http_version 1.1;

        # Anti-spoofing header hygiene
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # General Backend REST API
    location /api/ {
        limit_req zone=prod_api_limit burst=25 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # Frontend Single Page Application fallback routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static Assets Long-Term Caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2|woff|ttf)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
}
