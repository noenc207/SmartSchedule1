{
  "manifest_version": 3,
  "name": "SmartSchedule — Universal Schedule Importer",
  "version": "1.0.0",
  "description": "Detects university portals, extracts timetable information from DOM, and syncs collision-free into SmartSchedule.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SmartSchedule Importer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.edu.vn/*",
        "http://*.edu.vn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.edu.vn/*",
    "http://*.edu.vn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
