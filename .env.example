# ==============================================================================
# SmartSchedule Production & Deployment Environment Variables
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=smartschedule
POSTGRES_USER=smartschedule
POSTGRES_PASSWORD=replace-with-a-secure-db-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/smartschedule
SPRING_DATASOURCE_USERNAME=smartschedule
SPRING_DATASOURCE_PASSWORD=replace-with-a-secure-db-password

# --- Spring Boot Runtime ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Authentication & Security ---
# Generate with: openssl rand -base64 32
SMARTSCHEDULE_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret-base64-key
SMARTSCHEDULE_SECURE_COOKIE=true
SMARTSCHEDULE_CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# --- Registration Activation Key (Required for Temporary Testing Deployment) ---
# New users must supply this key on the register screen to create an account.
# Keep this secret from public repositories and client-side code!
SMARTSCHEDULE_REGISTRATION_KEY=replace-with-your-secret-activation-key

# --- Plan Mode (Temporary Deployment All Users PRO) ---
# Options:
#   ALL_PRO  - All registered users are granted PRO features temporarily.
#   STANDARD - Standard tier gating (FREE vs PRO based on DB subscription).
SMARTSCHEDULE_PLAN_MODE=ALL_PRO

# --- Rate Limiting & Abuse Protection ---
SMARTSCHEDULE_RATE_LIMIT_ENABLED=true
SMARTSCHEDULE_RATE_LIMIT_REGISTER_PER_MIN=5
SMARTSCHEDULE_RATE_LIMIT_LOGIN_PER_MIN=15
SMARTSCHEDULE_RATE_LIMIT_REFRESH_PER_MIN=30

# --- Background Jobs ---
SMARTSCHEDULE_REMINDER_DELAY_MS=60000

# --- Google OAuth 2.0 Identity Configuration ---
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Authorized JavaScript origin: http://localhost:5173, https://your-domain.com
# Authorized redirect URI: http://localhost:5173/auth/google/callback, https://your-domain.com/auth/google/callback
SMARTSCHEDULE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Frontend Build & Client Configuration ---
# Frontend API URL (for local Vite dev or Vercel deployment)
# Local: http://localhost:8080 (or omit if using reverse proxy /api/v1)
# Vercel: https://your-backend-api-domain.com
VITE_API_URL=http://localhost:8080
# Leave as /api/v1 when using Nginx reverse proxy
VITE_API_BASE_URL=/api/v1
# real: disable local demo fallbacks and require genuine backend authentication
VITE_API_MODE=real
# Optional: explicitly disable demo mode UI
VITE_DEMO_DISABLED=true

# --- SmartSchedule AI Gateway & Multi-Provider Architecture (Backend Only) ---
# CRITICAL: Backend holds all keys securely. NEVER prefix with VITE_ or expose to client!
# Primary Provider: WayJet (OpenAI-compatible)
WAYJET_API_KEY=your-wayjet-api-key-here
WAYJET_BASE_URL=https://api.xah.io/v1
WAYJET_MODEL=mainnewnol/gpt-5.6-luna

# AI Routing & Resilience
AI_PRIMARY_PROVIDER=wayjet
AI_FALLBACK_ORDER=gemini,groq,third_fallback
AI_DAILY_REQUEST_LIMIT=20
AI_REQUESTS_PER_MINUTE=5
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_TIMEOUT_SECONDS=30
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_OUTPUT_TOKENS=1024

# Fallback Provider 1: Google Gemini (Existing Key Pool supported: comma/space separated)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Fallback Provider 2: Groq (OpenAI-compatible high-speed inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Provider 3: Generic OpenAI-compatible Provider (OpenAI / OpenRouter / Together)
THIRD_PROVIDER_API_KEY=your-third-provider-api-key-here
THIRD_PROVIDER_BASE_URL=https://api.openai.com/v1
THIRD_PROVIDER_MODEL=gpt-4o-mini


